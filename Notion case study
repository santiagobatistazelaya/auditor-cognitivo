<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>CRO Case Study: Auditing Notion with the LIFT Model</title>
<style>
  :root{
    --bg:#faf8f3; --card:#faf8f3; --ink:#1a1a1a; --sub:#6b6b6b;
    --accent:#1a1a1a; --accent-soft:#efebe2; --line:#ddd7c8;
    box-sizing:border-box;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
  }
  html{scroll-padding-top:env(safe-area-inset-top,0px); color-scheme:light;}
  *{box-sizing:border-box;}
  body{
    margin:0; background:var(--bg); color:var(--ink);
    font-family:Georgia,"Times New Roman",serif;
    line-height:1.6;
  }
  .wrap{max-width:720px; margin:0 auto; padding:0 1.25rem 4rem;}
  header{
    text-align:center; margin-bottom:2.5rem;
    padding:3.5rem 1rem 2rem;
  }
  .badge{
    display:inline-flex; align-items:center; gap:6px; font-size:.7rem; letter-spacing:2px; text-transform:uppercase;
    color:var(--sub); border:1px solid var(--line); border-radius:20px;
    padding:5px 14px; margin-bottom:1.4rem; font-family:-apple-system,BlinkMacSystemFont,sans-serif; font-weight:600;
  }
  h1{
    font-size:2rem; font-weight:700; margin:0 0 1.2rem; letter-spacing:0;
    line-height:1.25; font-family:Georgia,"Times New Roman",serif;
  }
  .byline{
    color:var(--sub); font-size:.8rem; margin:0; letter-spacing:2px; text-transform:uppercase;
    font-family:-apple-system,BlinkMacSystemFont,sans-serif; font-weight:600;
  }
  section{background:var(--card); border:1px solid var(--line); border-radius:0; padding:1.8rem 0; margin-bottom:0; border-left:none; border-right:none; border-top:none; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;}
  section + section{border-top:1px solid var(--line);}
  h2{
    font-size:.75rem; margin:0 0 1.1rem; letter-spacing:2px; text-transform:uppercase;
    color:var(--ink); font-weight:600; font-family:-apple-system,BlinkMacSystemFont,sans-serif;
  }
  p{margin:0 0 .8rem; color:var(--ink);}
  .sub{color:var(--sub); font-size:.9rem;}
  .bullet{display:flex; gap:.7rem; margin-bottom:.9rem; align-items:flex-start;}
  .bullet .dot{color:var(--ink); flex-shrink:0; font-weight:900;}
  .bar-row{margin-bottom:.9rem;}
  .bar-label{display:flex; justify-content:space-between; font-size:.85rem; margin-bottom:4px;}
  .bar-track{background:var(--accent-soft); border-radius:0; height:8px; overflow:hidden;}
  .bar-fill{background:var(--accent); height:100%; border-radius:0;}
  .wire{display:flex; gap:1px; margin:1rem 0; background:var(--line);}
  .wire-block{flex:1; background:var(--card); padding:1.1rem .6rem; text-align:center;}
  .wire-block .score{font-weight:700; color:var(--ink); font-size:1.5rem; font-family:Georgia,serif;}
  .wire-block .name{font-size:.7rem; color:var(--sub); text-transform:uppercase; letter-spacing:1px; margin-top:4px;}
  blockquote{
    margin:0 0 1rem; padding:.9rem 1.1rem; background:var(--accent-soft);
    border-left:3px solid var(--ink); border-radius:0; font-style:italic; font-size:.95rem;
  }
  .grid2{display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--line);}
  @media (max-width:560px){.grid2{grid-template-columns:1fr;}}
  .opt{background:var(--card); padding:1.2rem;}
  .opt h3{margin:0 0 .5rem; font-size:.85rem; text-transform:uppercase; letter-spacing:1px; font-weight:800;}
  .opt .uso{color:var(--sub); font-weight:700; font-size:.75rem; margin-bottom:.6rem; text-transform:uppercase; letter-spacing:.5px;}
  .opt .copy{font-size:.9rem; margin-bottom:.7rem;}
  .opt .just{font-size:.8rem; color:var(--sub); font-style:italic;}
  footer{text-align:center; margin-top:0; color:var(--sub); font-size:.85rem; padding:2.5rem 0 1rem;}
  footer a{color:var(--ink); font-weight:700; text-decoration:underline;}
  .tool-note{font-size:.8rem; color:var(--sub); margin-top:1rem; text-align:center; letter-spacing:1px; text-transform:uppercase;}
</style>
